
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-management-server",
	"main": "src/index.js",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dev-summit",
			"database_id": "c9302b1b-b315-4155-a080-e5e825936da9"
		}
	]
}